<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_charge_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView android:id="@+id/widget_charge_state"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:text="@string/widget_charge_state_placeholder" android:textColor="@color/widget_secondary"
        android:textSize="12sp" android:letterSpacing="0.08" />

    <TextView android:id="@+id/widget_charge_soc"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="center"
        android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end"
        android:text="@string/widget_soc_placeholder" android:textColor="@color/widget_text"
        android:textSize="56sp" />

    <ProgressBar android:id="@+id/widget_charge_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:max="100" android:progress="0"
        android:progressTint="@color/widget_accent" />

    <TextView android:id="@+id/widget_charge_eta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:text="@string/widget_sync_never" android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <TextView android:id="@+id/widget_charge_sync"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:text="@string/widget_sync_never" android:textColor="@color/widget_secondary"
        android:textSize="10sp" />
</LinearLayout>
