<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:contentDescription="@string/widget_content_description">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textAllCaps="true"
            android:textColor="#98A0A5"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_connection_offline"
            android:textAllCaps="true"
            android:textColor="#7BD89C"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_soc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_soc_placeholder"
        android:textColor="#F3F0EA"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_range_placeholder"
        android:textColor="#7BD89C"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_modes_label" android:textColor="#98A0A5" android:textSize="11sp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3F0EA" android:textSize="12sp" android:maxLines="3" />
        <ImageView android:id="@+id/widget_graph" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp" android:contentDescription="@string/widget_graph_description" android:scaleType="fitXY" />
        <TextView android:id="@+id/widget_charge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#98A0A5" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_sync_never"
        android:textColor="#98A0A5"
        android:textSize="11sp" />
</LinearLayout>
