<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mode_tile" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
    android:paddingHorizontal="8dp" android:paddingVertical="6dp" android:background="@drawable/widget_mode_background">
    <TextView android:id="@+id/widget_mode_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/widget_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/widget_mode_range" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_text" android:textSize="18sp" />
</LinearLayout>
